# Database settings (MySQL connection)
DATABASE_URL="mysql://root:root@localhost:3306/civix"

# JWT Auth settings
JWT_SECRET="your-super-secret-jwt-key"
JWT_REFRESH_SECRET="your-super-secret-refresh-jwt-key"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Server Port settings
PORT=5000
FRONTEND_URL="http://localhost:5173"

# AI services
AI_PROVIDER="gemini"
AI_SERVICE_URL="http://localhost:8000"
GEMINI_API_KEY="your-gemini-api-key"

# External Notification & Messaging Integrations
# -------------------------------------------------------------
# 1. WhatsApp Integration (Twilio WhatsApp API / Meta Cloud API)
# If left unset, dispatches are formatted and simulated with visual console logs
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# 2. Email Integration (SMTP / SendGrid / Amazon SES)
# If left unset, responsive HTML emails are formatted and simulated with visual console logs
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="Civix Municipal Portal <no-reply@civix.gov>"
