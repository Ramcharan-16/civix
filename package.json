{
  "name": "civix",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"cyan,magenta\" \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:all": "concurrently -n \"API,WEB,AI\" -c \"cyan,magenta,yellow\" \"pnpm dev:api\" \"pnpm dev:web\" \"pnpm dev:ai\"",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:ai": "pnpm --filter ai-service dev",
    "build": "pnpm --filter database exec prisma generate && pnpm --filter api build && pnpm --filter web build",
    "build:api": "pnpm --filter database exec prisma generate && pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "start:api": "pnpm --filter api start",
    "db:migrate": "pnpm --filter database migrate",
    "db:seed": "pnpm --filter database seed",
    "test:api": "pnpm --filter api test"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "puppeteer",
      "bcrypt",
      "prisma",
      "@prisma/client",
      "@prisma/engines"
    ]
  }
}
